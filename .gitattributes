# Path-based git attributes
# https://git-scm.com/docs/gitattributes

# Exclude non-runtime files from Composer dist archives
/.github                export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/.editorconfig          export-ignore
/.env.example           export-ignore
/tests                  export-ignore
/phpunit.xml            export-ignore
/phpstan.neon           export-ignore
/phpstan.neon.dist      export-ignore
/pint.json              export-ignore
/content                export-ignore
/founder                export-ignore
/photos                 export-ignore
/INSTALLATION.md        export-ignore
/PACKAGE_SUMMARY.md     export-ignore
/QUICK_START.md         export-ignore
/TESTING.md             export-ignore
/CHANGELOG.md           export-ignore
